# HTTP server
ESP_LISTEN_ADDR=:8080
ESP_DATABASE_PATH=./data/emby-service-portal.db

# The base URL may include Emby's /emby path.
ESP_EMBY_BASE_URL=http://127.0.0.1:8096/emby
ESP_EMBY_API_KEY=replace-with-emby-admin-api-key

# External REST callers must send this value in X-API-Key.
ESP_API_KEY=replace-with-a-long-random-api-key

# Separate 32+ character key for encrypted managed Emby passwords. Keep the
# previous primary key here only while rotating keys; legacy API-key-encrypted
# entries remain readable automatically during an upgrade.
ESP_CREDENTIAL_MASTER_KEY=replace-with-a-separate-32-character-or-longer-secret
ESP_CREDENTIAL_PREVIOUS_MASTER_KEY=

# Only used to create the first administrator. It never overwrites an existing one.
ESP_ADMIN_USERNAME=admin
ESP_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Use true behind HTTPS in production. False is only for local HTTP development.
ESP_COOKIE_SECURE=true
ESP_SESSION_TTL=24h

# IANA time zone for all web-page time displays and admin time inputs.
# Examples: UTC, Asia/Shanghai, America/New_York.
ESP_TIME_ZONE=Asia/Shanghai

# Optional: The Movie Database (https://www.themoviedb.org) API read access
# token or API key v3, enabling the portal 求剧 (media request) feature.
# When empty the 求剧 pages show a setup notice and searches are disabled.
# Do not commit your real key.
ESP_TMDB_API_KEY=

# Optional TMDB network overrides for deployments where the official hosts are
# slow or unreachable (e.g. mainland China):
#   ESP_TMDB_BASE_URL       TMDB API root (mirror/reverse proxy). Must include the
#                           /3 path segment the mirror serves. Default https://api.themoviedb.org/3
#   ESP_TMDB_IMAGE_BASE_URL Poster CDN root used by rendered poster <img> and the
#                           page CSP. Default https://image.tmdb.org/t/p/w342
#   ESP_TMDB_HTTP_PROXY     Route TMDB API calls through an HTTP(S) or SOCKS5 proxy
#                           (service-side routing; posters are loaded by the browser).
#   ESP_TMDB_TIMEOUT        Per-request timeout for TMDB API calls. Default 10s.
# ESP_TMDB_BASE_URL=
# ESP_TMDB_IMAGE_BASE_URL=
# ESP_TMDB_HTTP_PROXY=
# ESP_TMDB_TIMEOUT=10s
